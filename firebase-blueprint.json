{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered farmer profile with contact details and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "email": { "type": "string" },
        "preferredLanguage": { "type": "string", "enum": ["bn", "en"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["uid", "displayName", "createdAt"]
    },
    "Farm": {
      "title": "Farm",
      "description": "Smallholder livestock or poultry farm unit",
      "type": "object",
      "properties": {
        "farmId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "farmName": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "speciesPresent": { "type": "array" },
        "farmType": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["farmId", "ownerUid", "farmName", "district", "upazila", "createdAt"]
    },
    "Animal": {
      "title": "Animal",
      "description": "Individual ruminant or large livestock animal record",
      "type": "object",
      "properties": {
        "animalId": { "type": "string" },
        "farmId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "species": { "type": "string" },
        "animalName": { "type": "string" },
        "breed": { "type": "string" },
        "sex": { "type": "string", "enum": ["male", "female"] },
        "estimatedAgeMonths": { "type": "number" },
        "tagNumber": { "type": "string" },
        "currentStatus": { "type": "string", "enum": ["healthy", "needs_attention", "isolated", "sold", "archived"] },
        "productionStage": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["animalId", "farmId", "ownerUid", "species", "animalName", "createdAt"]
    },
    "Flock": {
      "title": "Flock",
      "description": "Batch or flock record for broiler, layer, or sonali poultry",
      "type": "object",
      "properties": {
        "flockId": { "type": "string" },
        "farmId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "species": { "type": "string" },
        "flockType": { "type": "string" },
        "birdCount": { "type": "number" },
        "placementDate": { "type": "string" },
        "productionPurpose": { "type": "string" },
        "housingSystem": { "type": "string" },
        "currentStatus": { "type": "string", "enum": ["active", "depleted", "culled", "archived"] },
        "mortalityCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDemo": { "type": "boolean" }
      },
      "required": ["flockId", "farmId", "ownerUid", "species", "flockType", "birdCount", "placementDate", "createdAt"]
    },
    "CareTask": {
      "title": "CareTask",
      "description": "Scheduled vaccination or deworming task based on approved protocol",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "farmId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "targetType": { "type": "string", "enum": ["animal", "flock"] },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "species": { "type": "string" },
        "careType": { "type": "string", "enum": ["vaccination", "deworming", "routine_hygiene"] },
        "titleBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "descriptionBn": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "due_soon", "overdue", "completed", "missed", "rescheduled"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["taskId", "farmId", "ownerUid", "targetType", "targetId", "careType", "dueDate", "status"]
    },
    "CareRecord": {
      "title": "CareRecord",
      "description": "Permanent log of completed vaccination or deworming administration",
      "type": "object",
      "properties": {
        "recordId": { "type": "string" },
        "farmId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "targetType": { "type": "string", "enum": ["animal", "flock"] },
        "targetId": { "type": "string" },
        "species": { "type": "string" },
        "careType": { "type": "string", "enum": ["vaccination", "deworming", "routine_hygiene"] },
        "diseaseOrTarget": { "type": "string" },
        "productName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "dateAdministered": { "type": "string" },
        "administeredBy": { "type": "string" },
        "verifiedByVet": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "missed"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["recordId", "farmId", "ownerUid", "targetType", "targetId", "careType", "diseaseOrTarget", "dateAdministered"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app reminder and alert message for farmer",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "farmId": { "type": "string" },
        "relatedAnimalId": { "type": "string" },
        "relatedCareTaskId": { "type": "string" },
        "notificationType": { "type": "string", "enum": ["vaccine_reminder", "deworm_reminder", "biosecurity_alert", "outbreak_warning", "system_notice"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "scheduledAt": { "type": "string" },
        "readStatus": { "type": "boolean" },
        "deliveryStatus": { "type": "string", "enum": ["in_app_delivered", "pending", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["notificationId", "ownerUid", "notificationType", "title", "message", "scheduledAt"]
    },
    "DailyBiosecurityChecklist": {
      "title": "DailyBiosecurityChecklist",
      "description": "Daily verified biosecurity checklist entries for smallholder farm",
      "type": "object",
      "properties": {
        "checklistId": { "type": "string" },
        "farmId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "date": { "type": "string" },
        "itemsCompleted": { "type": "array" },
        "totalItems": { "type": "number" },
        "scorePercent": { "type": "number" },
        "inspectorName": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["checklistId", "farmId", "ownerUid", "date", "itemsCompleted", "scorePercent"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Farmer profiles and account settings"
    },
    "/farms/{farmId}": {
      "schema": { "$ref": "#/entities/Farm" },
      "description": "Farms owned by farmers"
    },
    "/animals/{animalId}": {
      "schema": { "$ref": "#/entities/Animal" },
      "description": "Individual livestock animal records"
    },
    "/flocks/{flockId}": {
      "schema": { "$ref": "#/entities/Flock" },
      "description": "Poultry flocks and batches"
    },
    "/careTasks/{taskId}": {
      "schema": { "$ref": "#/entities/CareTask" },
      "description": "Scheduled protocol tasks"
    },
    "/careRecords/{recordId}": {
      "schema": { "$ref": "#/entities/CareRecord" },
      "description": "Administered care logs"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Farmer notifications and reminders"
    },
    "/biosecurityChecklists/{checklistId}": {
      "schema": { "$ref": "#/entities/DailyBiosecurityChecklist" },
      "description": "Daily hygiene and biosecurity checklists"
    }
  }
}
